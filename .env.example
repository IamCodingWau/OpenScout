# OpenScout Configuration
PROJECT_NAME="OpenScout"
DEMO_MODE=true
DATABASE_URL="sqlite:///./data/openscout.db"

# Open-Weight AI Model Settings (Ollama / Local Inference)
OLLAMA_URL="http://localhost:11434"
MODEL_NAME="gemma2:2b"
# Notification threshold: minimum relevance score (0.0 to 1.0) to trigger notification
NOTIFICATION_THRESHOLD=0.80

# Notification Settings
NOTIFICATION_CHANNEL="log" # 'log' or 'email'
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="password"
NOTIFY_EMAIL_TO="friend@example.com"
